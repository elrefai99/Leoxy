---
import BaseLayout from '../layouts/BaseLayout.astro';
const title = 'Page not found — Leoxy';
const description = 'The requested Leoxy page could not be found.';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title={title} description={description}>
  <main class="not-found wrap">
    <span class="eyebrow">404</span>
    <h1>Page not found.</h1>
    <p>The address may be incorrect or the page may have moved.</p>
    <a class="button button-primary" href={`${base}/`}>Return home</a>
  </main>
  <style>
    .not-found{min-height:65vh;display:flex;flex-direction:column;align-items:flex-start;justify-content:center}.not-found h1{margin:22px 0 8px}.not-found p{color:var(--muted);margin-bottom:24px}
  </style>
</BaseLayout>
