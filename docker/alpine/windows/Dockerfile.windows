# escape=`
ARG GO_VERSION=1.27.3
FROM golang:${GO_VERSION}-windowsservercore-ltsc2022 AS builder

SHELL ["powershell", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

ENV CGO_ENABLED=0 GOWORK=off

WORKDIR C:\src\app

COPY app/go.mod app/go.sum ./

RUN go mod download

COPY app/ ./

RUN New-Item -ItemType Directory -Force C:\out | Out-Null; go build -trimpath -ldflags '-s -w' -o C:\out\leoxy.exe .\cli

FROM mcr.microsoft.com/windows/nanoserver:ltsc2022

ENV LEOXY_HOST=0.0.0.0 PORT=80

WORKDIR C:\app

COPY --from=builder C:\out\leoxy.exe C:\leoxy.exe
COPY docs/html C:\app\docs\html

EXPOSE 80

ENTRYPOINT ["C:\\leoxy.exe"]
