
FROM golang:1.27.3-windowsservercore-ltsc2022 AS builder

WORKDIR C:/app

COPY app/go.mod app/go.sum ./
RUN go mod download

COPY . .

RUN New-Item -ItemType Directory -Force C:/out | Out-Null; go build -trimpath -ldflags="-s -w" -o C:/out/leoxy.exe ./app/cli

FROM mcr.microsoft.com/windows/nanoserver:ltsc2022

WORKDIR C:/app

COPY --from=builder C:/out/leoxy.exe C:/leoxy.exe
COPY --from=builder C:/app/docs/html C:/app/docs/html

EXPOSE 4444

ENTRYPOINT ["C:\\leoxy.exe"]
